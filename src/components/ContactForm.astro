---
import { WEB3FORMS_ACCESS_KEY } from '../config';
import site from '../data/site.json';
---

<form
  class="contact-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-contact-form
>
  <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
  <input type="hidden" name="subject" value="Message from the website" />
  <input type="hidden" name="from_name" value={site.companyName + ' website'} />
  <!-- Honeypot: real people never see or tick this, bots do. -->
  <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="form-row">
    <label>
      Name <span class="req">(required)</span>
      <input type="text" name="name" required maxlength="200" autocomplete="name" />
    </label>
    <label>
      Email <span class="req">(required)</span>
      <input type="email" name="email" required maxlength="200" autocomplete="email" />
    </label>
  </div>
  <label>
    Phone <span class="req">(optional)</span>
    <input type="tel" name="phone" maxlength="40" autocomplete="tel" />
  </label>
  <label>
    How can we help?
    <textarea name="message" rows="6" maxlength="4000" placeholder="Tell us about your project, the openings involved, or what needs fixing."></textarea>
  </label>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary btn-send">
      Send Message
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
    </button>
    <p class="form-status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      status.className = 'form-status';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || data.success === false) throw new Error(data.message || 'Request failed');
        form.reset();
        status.classList.add('is-success');
        status.textContent = 'Thank you for your message. It has been sent.';
      } catch {
        status.classList.add('is-error');
        status.textContent =
          'There was an error sending your message. Please try again, or call or email us directly.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
