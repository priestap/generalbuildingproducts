---
import site from '../data/site.json';
import { mapsUrl, telUrl } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>
      <a href={telUrl(site.phone)}><strong>{site.phone}</strong></a>
      <span class="pipe" aria-hidden="true">|</span>
      <a href={mapsUrl(site.street, site.cityStateZip)}>{site.street}, {site.cityStateZip}</a>
    </p>
    <p class="copyright">
      Copyright &copy; {site.copyrightStartYear} – {year}. {site.companyName} All Rights Reserved.
    </p>
  </div>
</footer>
