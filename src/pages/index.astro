---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import HighlightIcon from '../components/HighlightIcon.astro';
import DoorBlueprint from '../components/DoorBlueprint.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import about from '../data/about.json';
import staff from '../data/staff.json';
import testimonials from '../data/testimonials.json';
import products from '../data/products.json';
import { mapsUrl, telUrl } from '../lib/url';
import { slugify, uniqueBrandNames } from '../lib/slug';

import heroImg from '../assets/hero.jpg';

// Background images can't use <Image>, so optimize them here and pass the URLs to CSS.
const heroBg = await getImage({ src: heroImg, width: 1800, format: 'webp', quality: 72 });
const heroBgSmall = await getImage({ src: heroImg, width: 900, format: 'webp', quality: 70 });

const { showStaff = false, showTestimonials = false } = home.sections ?? {};

// Categories sharing a photo (e.g. Misc. and Lockers) would look repetitive as tiles, so show each photo once.
const seenImages = new Set<string>();
const categoryTiles = products.filter((c) => {
  if (!c.image || seenImages.has(c.image)) return false;
  seenImages.add(c.image);
  return true;
});
const brands = uniqueBrandNames(products);
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(`${site.street}, ${site.cityStateZip}`)}&z=15&output=embed`;

const slides = (home.projects?.slides ?? []).filter((sl) => sl.image);
---

<Base overlayHeader>
  <section
    id="hero"
    class="parallax"
    style={`--bg: url('${heroBg.src}'); --bg-small: url('${heroBgSmall.src}');`}
  >
    <div class="parallax-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <h1>{home.hero.heading}</h1>
      {home.hero.paragraphs.map((p) => <p>{p}</p>)}
      <div class="hero-actions">
        <a class="btn btn-primary" href="#contact">Contact Us</a>
        <a class="btn btn-ghost" href="/products/">Browse Products</a>
      </div>
    </div>
  </section>

  {
    home.stats?.length > 0 && (
      <section class="stats" aria-label="General Building Products at a glance">
        <ul class="container stats-list">
          {home.stats.map((s) => (
            <li>
              {/^\d+/.test(s.value) ? (
                <>
                  <span class="stat-value" data-count={s.value} aria-hidden="true">{s.value}</span>
                  <span class="sr-only">{s.value}</span>
                </>
              ) : (
                <span class="stat-value">{s.value}</span>
              )}
              <span class="stat-label">{s.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section id="service" class="section texture services-section">
    <div class="container services-layout">
      <div class="services-intro">
        <p class="smallcaps">{home.servicesIntro?.eyebrow ?? 'Services We Offer'}</p>
        <h2 class="section-title">{home.servicesIntro?.heading ?? 'What We Do'}</h2>
        {home.servicesIntro?.text && <p>{home.servicesIntro.text}</p>}
      </div>
      <ul class="services-grid">
        {
          home.services.map((s) => (
            <li class="service-item">
              <span class="service-icon">
                {s.icon && <img src={s.icon} alt="" width="40" height="40" loading="lazy" />}
              </span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            </li>
          ))
        }
        <li class="service-item service-cta">
          <div>
            <h3>{home.servicesCta?.heading ?? 'Not sure what you need?'}</h3>
            {home.servicesCta?.text && <p>{home.servicesCta.text}</p>}
            <a class="service-phone" href={telUrl(site.phone)}>{site.phone}</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  {
    home.highlights?.items?.length > 0 && (
      <section id="why" class="section why">
        <div class="container">
          <div class="why-head">
            <p class="smallcaps">{home.highlights.eyebrow}</p>
            <h2 class="section-title">{home.highlights.heading}</h2>
          </div>
          <ul class="why-list">
            {home.highlights.items.map((h) => (
              <li class="why-item">
                <span class="why-icon">
                  <HighlightIcon name={h.icon} />
                </span>
                <h3>{h.title}</h3>
                <p>{h.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section id="supply" class="section supply text-center">
    <div class="container">
      <p class="smallcaps">Our Products</p>
      <h2 class="section-title">What We Supply</h2>
      <ul class="tile-grid">
        {
          categoryTiles.map((c) => (
            <li>
              <a class="tile" href={`/products/#${slugify(c.category)}`}>
                <img src={c.image} alt="" width="400" height="270" loading="lazy" />
                <span>{c.category}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-outline" href="/products/">See all {products.length} product categories</a>
    </div>
  </section>

  {
    brands.length > 0 && (
      <section class="brands" aria-label="Manufacturers we carry">
        <p class="brands-label">Manufacturers we carry</p>
        <div class="marquee">
          {[0, 1].map((copy) => (
            <ul class="marquee-row" aria-hidden={copy === 1 ? 'true' : undefined}>
              {brands.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          ))}
        </div>
      </section>
    )
  }

  <section id="about" class="section">
    <div class="container about-intro">
      <div class="about-art">
        <div class="blueprint-panel"><DoorBlueprint /></div>
        <span class="since-badge" aria-hidden="true"><small>Since</small>1968</span>
      </div>
    <div class="about-content">
      <p class="smallcaps">{home.about?.eyebrow ?? 'Who We Are'}</p>
      <h2 class="section-title">{home.about?.heading ?? 'About Us'}</h2>
      {(home.about?.paragraphs ?? about.paragraphs).map((p, i) => <p class:list={{ 'about-lead': i === 0 }}>{p}</p>)}
      <a class="btn btn-outline" href="/about-us/">{home.about?.linkLabel ?? 'More about us'}</a>
    </div>
    </div>
  </section>

  {
    slides.length > 0 && (
      <section id="history" class="history" aria-roledescription="carousel" aria-label={home.projects?.eyebrow ?? 'Around Toledo'}>
        <div class="history-track" tabindex="0">
          {slides.map((sl, i) => (
            <figure class="history-slide" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`}>
              <img src={sl.image} alt={sl.title ?? ''} width="1200" height="560" loading="lazy" />
              {(sl.title || sl.caption) && (
                <figcaption class="history-caption">
                  {home.projects?.eyebrow && <span class="history-eyebrow">{home.projects.eyebrow}</span>}
                  {sl.title && <span class="history-title">{sl.title}</span>}
                  {sl.caption && <span class="history-sub">{sl.caption}</span>}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
        {slides.length > 1 && (
          <>
            <button class="history-btn prev" type="button" aria-label="Previous slide">‹</button>
            <button class="history-btn next" type="button" aria-label="Next slide">›</button>
            <div class="history-dots" aria-hidden="true">
              {slides.map((_, i) => <span class:list={{ active: i === 0 }} />)}
            </div>
          </>
        )}
      </section>
    )
  }


  {showStaff && (
  <section id="staff" class="section dark text-center">
    <div class="container">
      <p class="smallcaps">Our Experienced Pros</p>
      <h2 class="section-title">Our Staff</h2>
      <ul class="team">
        {
          staff.map((m) => (
            <li class="team-member">
              <img src={m.photo || '/images/staff/placeholder.jpg'} alt="" width="300" height="450" loading="lazy" />
              <div class="team-info">
                <h3>{m.name}</h3>
                {m.title && <p>{m.title}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  )}

  {showTestimonials && (
  <section id="testimonial" class="parallax" style={`--bg: url('${heroBg.src}'); --bg-small: url('${heroBgSmall.src}');`}>
    <div class="parallax-bg" aria-hidden="true"></div>
    <div class="container text-center">
      <p class="smallcaps">What Our Customers Say</p>
      <h2 class="section-title">Testimonials</h2>
      <div class="testimonials">
        {
          testimonials.map((t) => (
            <blockquote class="testimonial">
              <p>{t.quote}</p>
              <footer>
                {t.photo && <img src={t.photo} alt="" width="56" height="56" loading="lazy" />}
                <cite>{t.name}</cite>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>
  )}

  <section id="contact" class="section texture">
    <div class="container">
      <div class="text-center">
        <p class="smallcaps">{home.contactIntro?.eyebrow ?? 'Write to us today'}</p>
        <h2 class="section-title">{home.contactIntro?.heading ?? 'Get In Touch'}</h2>
        {home.contactIntro?.text && <p class="contact-intro">{home.contactIntro.text}</p>}
      </div>
      <div class="contact-grid">
        <ContactForm />
        <div class="contact-side">
          <address class="contact-details">
            <p><b>Tel:</b> <a href={telUrl(site.phone)}>{site.phone}</a></p>
            {site.fax && <p><b>Fax:</b> {site.fax}</p>}
            <p><b>E-Mail:</b> <a href={`mailto:${site.email}`}>{site.email}</a></p>
            <h3>Visit us:</h3>
            <p>
              {site.street}<br />{site.cityStateZip}
            </p>
            {
              site.hours?.length > 0 && (
                <>
                  <h3>Hours:</h3>
                  <ul class="hours">
                    {site.hours.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </>
              )
            }
          </address>
          <div class="map">
            <iframe
              src={mapEmbed}
              title={`Map of ${site.street}, ${site.cityStateZip}`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
          <a class="directions" href={mapsUrl(site.street, site.cityStateZip)} target="_blank" rel="noopener">
            Get directions →
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Parallax: the background layer moves slower than the page as you scroll.
  // Done with a transform (not background-attachment: fixed) so it works in every browser, phones included.
  const layers = [...document.querySelectorAll<HTMLElement>('.parallax-bg')];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const SPEED = 0.35; // must match --parallax-speed in global.css

  if (layers.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      if (reduceMotion.matches) {
        layers.forEach((l) => (l.style.transform = ''));
        return;
      }
      const vh = window.innerHeight;
      for (const layer of layers) {
        const rect = layer.parentElement!.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > vh) continue; // off screen
        layer.style.transform = `translate3d(0, ${(-rect.top * SPEED).toFixed(1)}px, 0)`;
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    reduceMotion.addEventListener('change', update);
  }

  // Stats: count up from 0 to the number ("55+", "50 States") every time the band scrolls into view.
  const counters = [...document.querySelectorAll<HTMLElement>('.stat-value[data-count]')];
  if (counters.length && !reduceMotion.matches && 'IntersectionObserver' in window) {
    const DURATION = 700; // ms
    const parts = (el: HTMLElement) => {
      const [, num, suffix] = el.dataset.count!.match(/^(\d+)(.*)$/)!;
      return { target: Number(num), suffix };
    };
    const timers = new Map<HTMLElement, number>();
    const frames = new Map<HTMLElement, number>();
    const stop = (el: HTMLElement) => {
      clearTimeout(timers.get(el));
      cancelAnimationFrame(frames.get(el) ?? 0);
    };
    const reset = (el: HTMLElement) => {
      stop(el);
      el.textContent = `0${parts(el).suffix}`;
    };
    const run = (el: HTMLElement) => {
      stop(el);
      const { target, suffix } = parts(el);
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / DURATION);
        const eased = 1 - Math.pow(1 - t, 3); // ease-out: fast start, gentle landing
        el.textContent = `${Math.round(target * eased)}${suffix}`;
        if (t < 1) frames.set(el, requestAnimationFrame(tick));
      };
      frames.set(el, requestAnimationFrame(tick));
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.intersectionRatio >= 0.6) {
            // On first load the stats card is still rising in (CSS delay ~0.75s); wait so the count is visible.
            const wait = Math.max(0, 1050 - performance.now());
            timers.set(el, window.setTimeout(() => run(el), wait));
          } else if (!entry.isIntersecting) {
            reset(el); // fully out of view: ready to count again next time
          }
        }
      },
      { threshold: [0, 0.6] },
    );
    for (const el of counters) {
      reset(el);
      io.observe(el);
    }
  }

  const track = document.querySelector<HTMLElement>('.history-track');
  if (track) {
    const go = (dir: number) => {
      const w = track.clientWidth;
      const max = track.scrollWidth - w;
      let next = track.scrollLeft + dir * w;
      if (next > max + 1) next = 0; // wrap around
      if (next < -1) next = max;
      track.scrollTo({ left: next, behavior: 'smooth' });
    };
    document.querySelector('.history-btn.prev')?.addEventListener('click', () => go(-1));
    document.querySelector('.history-btn.next')?.addEventListener('click', () => go(1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(-1);
      if (e.key === 'ArrowRight') go(1);
    });
    const dots = [...document.querySelectorAll<HTMLElement>('.history-dots span')];
    if (dots.length) {
      track.addEventListener(
        'scroll',
        () => {
          const i = Math.round(track.scrollLeft / track.clientWidth);
          dots.forEach((d, j) => d.classList.toggle('active', j === i));
        },
        { passive: true },
      );
    }
  }
</script>
