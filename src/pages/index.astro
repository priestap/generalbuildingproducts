---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import HighlightIcon from '../components/HighlightIcon.astro';
import DoorBlueprint from '../components/DoorBlueprint.astro';
import site from '../data/site.json';
import home from '../data/home.json';
import about from '../data/about.json';
import staff from '../data/staff.json';
import testimonials from '../data/testimonials.json';
import products from '../data/products.json';
import brandLogos from '../data/brands.json';
import { mapsUrl, telUrl } from '../lib/url';
import { slugify, uniqueBrandNames } from '../lib/slug';
import { groupProducts } from '../lib/productGroups';

import heroImg from '../assets/hero.jpg';

// Background images can't use <Image>, so optimize them here and pass the URLs to CSS.
const heroBg = await getImage({ src: heroImg, width: 1800, format: 'webp', quality: 72 });
const heroBgSmall = await getImage({ src: heroImg, width: 900, format: 'webp', quality: 70 });

const { showStaff = false, showTestimonials = false } = home.sections ?? {};

const supplyGroups = groupProducts(products);
// Brand strip: every manufacturer we list, with its logo when one has been uploaded (Brand logos in the CMS).
// Brands without a logo yet show as text, so the strip never has gaps.
const logoFor = new Map(brandLogos.filter((b) => b.logo).map((b) => [b.name.toLowerCase(), b.logo]));
const brands = uniqueBrandNames(products).map((name) => ({ name, logo: logoFor.get(name.toLowerCase()) }));

const projects = (home.projects?.slides ?? []).filter((pr) => pr.image);
// Featured projects get the big "drawing sheet" cards; every project is listed in the schedule below
// them, numbered in one sequence (the sheets are 01, 02, ...).
const sheetNo = (pr: (typeof projects)[number]) => String(projects.indexOf(pr) + 1).padStart(2, '0');
const featured = projects.filter((pr) => pr.featured !== false);
const showSchedule = projects.length > featured.length;

// The owners appear beside "Talk to a person" in Get In Touch, once they have a photo.
const owners = (about.owners ?? []).filter((o) => o.name && o.photo);
---

<Base
  overlayHeader
  description="Commercial doors, frames, locks, and security hardware for Ohio, Michigan, and Indiana since 1968. In-house fabrication and installation, plus shipping nationwide."
>
  <section
    id="hero"
    class="parallax"
    style={`--bg: url('${heroBg.src}'); --bg-small: url('${heroBgSmall.src}');`}
  >
    <div class="parallax-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <h1>{home.hero.heading}</h1>
      {home.hero.paragraphs.map((p) => <p>{p}</p>)}
      <div class="hero-actions">
        <a class="btn btn-primary" href="#contact">Contact Us</a>
        <a class="btn btn-ghost" href="/products/">Browse Products</a>
      </div>
    </div>
  </section>

  {
    home.stats?.length > 0 && (
      <section class="stats" aria-label="General Building Products at a glance">
        <ul class="container stats-list">
          {home.stats.map((s) => (
            <li>
              {/^\d+/.test(s.value) ? (
                <>
                  <span class="stat-value" data-count={s.value} aria-hidden="true">{s.value}</span>
                  <span class="sr-only">{s.value}</span>
                </>
              ) : (
                <span class="stat-value">{s.value}</span>
              )}
              <span class="stat-label">{s.label}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section id="service" class="section texture services-section">
    <div class="container services-layout">
      <div class="services-intro">
        <p class="smallcaps">{home.servicesIntro?.eyebrow ?? 'Services We Offer'}</p>
        <h2 class="section-title">{home.servicesIntro?.heading ?? 'What We Do'}</h2>
        {home.servicesIntro?.text && <p>{home.servicesIntro.text}</p>}
      </div>
      <ul class="services-grid">
        {
          home.services.map((s) => (
            <li class="service-item">
              <span class="service-icon">
                {s.icon && <img src={s.icon} alt="" width="40" height="40" loading="lazy" />}
              </span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </div>
            </li>
          ))
        }
        <li class="service-item service-cta">
          <div>
            <h3>{home.servicesCta?.heading ?? 'Not sure what you need?'}</h3>
            {home.servicesCta?.text && <p>{home.servicesCta.text}</p>}
            <a class="service-phone" href={telUrl(site.phone)}>{site.phone}</a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  {
    home.highlights?.items?.length > 0 && (
      <section id="why" class="section why">
        <div class="container">
          <div class="why-head">
            <p class="smallcaps">{home.highlights.eyebrow}</p>
            <h2 class="section-title">{home.highlights.heading}</h2>
          </div>
          <ul class="why-list">
            {home.highlights.items.map((h) => (
              <li class="why-item">
                <span class="why-icon">
                  <HighlightIcon name={h.icon} />
                </span>
                <h3>{h.title}</h3>
                <p>{h.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section id="supply" class="section supply">
    <div class="container">
      <div class="supply-head">
        <div>
          <p class="smallcaps">{home.supplyIntro?.eyebrow ?? 'What We Supply'}</p>
          <h2 class="section-title">{home.supplyIntro?.heading ?? 'What We Supply'}</h2>
        </div>
        <div class="supply-head-side">
          {home.supplyIntro?.text && <p>{home.supplyIntro.text}</p>}
          <a class="btn btn-outline" href="/products/">Browse all {products.length} categories</a>
        </div>
      </div>
      <ul class="supply-groups">
        {
          supplyGroups.map((g) => (
            <li class="supply-group">
              <a class="sg-media" href={`/products/#${slugify(g.name)}`} tabindex="-1" aria-hidden="true">
                {g.items
                  .filter((c) => c.image)
                  .map((c, i) => (
                    <img
                      src={c.image}
                      alt=""
                      width="400"
                      height="270"
                      loading="lazy"
                      data-for={slugify(c.category)}
                      class:list={{ 'is-shown': i === 0 }}
                    />
                  ))}
                <span class="sg-count">{g.items.length} categories</span>
              </a>
              <div class="sg-body">
                <p class="sg-name">{g.name}</p>
                <h3>{g.pitch || g.name}</h3>
                <ul class="sg-tags" aria-label={`${g.name} categories`}>
                  {g.items.map((c) => (
                    <li>
                      <a href={`/products/#${slugify(c.category)}`} data-preview={slugify(c.category)}>
                        {c.category}
                      </a>
                    </li>
                  ))}
                </ul>
                <a class="sg-more" href={`/products/#${slugify(g.name)}`}>
                  Explore<span class="sr-only"> {g.name}</span>
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                  </svg>
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    brands.length > 0 && (
      <section class="brands" aria-label="Manufacturers we carry">
        <p class="brands-label">Manufacturers we carry</p>
        <div class="marquee">
          {[0, 1].map((copy) => (
            <ul class="marquee-row" aria-hidden={copy === 1 ? 'true' : undefined}>
              {brands.map((b) => (
                <li class:list={{ 'has-logo': b.logo }}>
                  {b.logo ? <img src={b.logo} alt={b.name} height="40" loading="lazy" decoding="async" /> : b.name}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </section>
    )
  }

  <section id="about" class="section">
    <div class="container about-intro">
      <div class="about-art">
        <div class="blueprint-panel"><DoorBlueprint /></div>
        <span class="since-badge" aria-hidden="true"><small>Since</small>1968</span>
      </div>
    <div class="about-content">
      <p class="smallcaps">{home.about?.eyebrow ?? 'Who We Are'}</p>
      <h2 class="section-title">{home.about?.heading ?? 'About Us'}</h2>
      {(home.about?.paragraphs ?? []).map((p, i) => <p class:list={{ 'about-lead': i === 0 }}>{p}</p>)}
    </div>
    </div>
  </section>

  <div class="drafting">
  {
    projects.length > 0 && (
      <section id="work" class="section work">
        <div class="container">
          <div class="work-head">
            <div>
              <p class="smallcaps">{home.projects?.eyebrow ?? 'Our Work'}</p>
              <h2 class="section-title">{home.projects?.heading ?? 'Openings around Toledo'}</h2>
            </div>
            {home.projects?.text && <p class="work-intro">{home.projects.text}</p>}
          </div>
          <ul class="work-grid">
            {featured.map((pr) => (
              <li class="work-sheet">
                <figure>
                  <div class="work-photo">
                    <img src={pr.image} alt={pr.title ?? ''} width="1200" height="560" loading="lazy" />
                  </div>
                  <figcaption class="title-block">
                    <span class="tb-cell tb-project">
                      <small>Project</small>
                      {pr.title}
                    </span>
                    {pr.caption && (
                      <span class="tb-cell tb-location">
                        <small>Location</small>
                        {pr.caption}
                      </span>
                    )}
                    <span class="tb-cell tb-sheet" aria-hidden="true">
                      <small>Sheet</small>
                      {sheetNo(pr)}
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>

          {showSchedule && (
            <div class="schedule">
              <div class="schedule-head">
                <h3>Project schedule</h3>
                <span>{projects.length} projects</span>
              </div>
              <table class="schedule-table">
                <thead>
                  <tr>
                    <th scope="col" class="sc-no">No.</th>
                    <th scope="col" class="sc-photo"><span class="sr-only">Photo</span></th>
                    <th scope="col">Project</th>
                    <th scope="col">Type</th>
                    <th scope="col">Location</th>
                  </tr>
                </thead>
                <tbody>
                  {projects.map((pr) => (
                    <tr>
                      <td class="sc-no">{sheetNo(pr)}</td>
                      <td class="sc-photo">
                        <span class="sc-thumb">
                          <img src={pr.image} alt="" width="480" height="360" loading="lazy" />
                        </span>
                      </td>
                      <th scope="row" class="sc-title">{pr.title}</th>
                      <td class="sc-type">{pr.type}</td>
                      <td class="sc-loc">{pr.caption || '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </section>
    )
  }

  {showStaff && (
  <section id="staff" class="section dark text-center">
    <div class="container">
      <p class="smallcaps">Our Experienced Pros</p>
      <h2 class="section-title">Our Staff</h2>
      <ul class="team">
        {
          staff.map((m) => (
            <li class="team-member">
              <img src={m.photo || '/images/staff/placeholder.jpg'} alt="" width="300" height="450" loading="lazy" />
              <div class="team-info">
                <h3>{m.name}</h3>
                {m.title && <p>{m.title}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  )}

  {showTestimonials && (
  <section id="testimonial" class="parallax" style={`--bg: url('${heroBg.src}'); --bg-small: url('${heroBgSmall.src}');`}>
    <div class="parallax-bg" aria-hidden="true"></div>
    <div class="container text-center">
      <p class="smallcaps">What Our Customers Say</p>
      <h2 class="section-title">Testimonials</h2>
      <div class="testimonials">
        {
          testimonials.map((t) => (
            <blockquote class="testimonial">
              <p>{t.quote}</p>
              <footer>
                {t.photo && <img src={t.photo} alt="" width="56" height="56" loading="lazy" />}
                <cite>{t.name}</cite>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>
  )}

  <section id="contact" class="section">
    <div class="container">
      <div class="text-center">
        <p class="smallcaps">{home.contactIntro?.eyebrow ?? 'Write to us today'}</p>
        <h2 class="section-title">{home.contactIntro?.heading ?? 'Get In Touch'}</h2>
        {home.contactIntro?.text && <p class="contact-intro">{home.contactIntro.text}</p>}
      </div>
      <div class="contact-card">
        <aside class="contact-panel" aria-label="Contact details">
          <p class="panel-eyebrow">Talk to a person</p>
          {owners.length > 0 && (
            <div class="panel-people">
              <span class="people-photos" aria-hidden="true">
                {owners.map((o) => (
                  <img src={o.photo} alt="" width="64" height="64" loading="lazy" />
                ))}
              </span>
              <span class="people-text">
                <span class="people-names">{owners.map((o) => o.name).join(' & ')}</span>
                <span class="people-title">{owners.length === 1 ? owners[0].title : 'Owners'}</span>
              </span>
            </div>
          )}
          <a class="contact-phone" href={telUrl(site.phone)}>
            <span class="contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path></svg>
            </span>
            <span>
              <small>Call us</small>
              {site.phone}
            </span>
          </a>

          <ul class="contact-list">
            <li>
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path></svg>
              </span>
              <span>
                <small>Email</small>
                <a href={`mailto:${site.email}`}>{site.email}</a>
              </span>
            </li>
            <li>
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path><circle cx="12" cy="9.5" r="2.5"></circle></svg>
              </span>
              <span>
                <small>Visit us</small>
                <address>{site.street}<br />{site.cityStateZip}</address>
              </span>
            </li>
            {
              site.hours?.length > 0 && (
                <li>
                  <span class="contact-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                  </span>
                  <span>
                    <small>Hours</small>
                    {site.hours.map((h) => (
                      <span class="hours-line">{h}</span>
                    ))}
                  </span>
                </li>
              )
            }
          </ul>

          <a class="btn btn-gold btn-directions" href={mapsUrl(site.street, site.cityStateZip)} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path>
              <circle cx="12" cy="9.5" r="2.5"></circle>
            </svg>
            Get Directions
            <span class="sr-only">(opens Google Maps in a new tab)</span>
          </a>

          {site.fax && <p class="contact-fax">Fax {site.fax}</p>}
        </aside>

        <div class="contact-form-wrap">
          <h3 class="form-title">Send us a message</h3>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>
  </div>
</Base>

<script>
  // Parallax: the background layer moves slower than the page as you scroll.
  // Done with a transform (not background-attachment: fixed) so it works in every browser, phones included.
  const layers = [...document.querySelectorAll<HTMLElement>('.parallax-bg')];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const SPEED = 0.35; // must match --parallax-speed in global.css

  if (layers.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      if (reduceMotion.matches) {
        layers.forEach((l) => (l.style.transform = ''));
        return;
      }
      const vh = window.innerHeight;
      for (const layer of layers) {
        const rect = layer.parentElement!.getBoundingClientRect();
        if (rect.bottom < 0 || rect.top > vh) continue; // off screen
        layer.style.transform = `translate3d(0, ${(-rect.top * SPEED).toFixed(1)}px, 0)`;
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    reduceMotion.addEventListener('change', update);
  }

  // What We Do: cards fade up once, in sequence, the first time the grid scrolls into view.
  // Skipped if the grid is already on screen at load (the hero has its own entrance then).
  const servicesGrid = document.querySelector<HTMLElement>('.services-grid');
  if (
    servicesGrid &&
    !reduceMotion.matches &&
    'IntersectionObserver' in window &&
    servicesGrid.getBoundingClientRect().top > window.innerHeight * 0.85
  ) {
    servicesGrid.classList.add('reveal-ready');
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          servicesGrid.classList.add('is-revealed');
          io.disconnect();
        }
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    io.observe(servicesGrid);
  }

  // What We Supply: pointing at a category crossfades the group's photo to that category.
  for (const card of document.querySelectorAll<HTMLElement>('.supply-group')) {
    const imgs = [...card.querySelectorAll<HTMLImageElement>('.sg-media img')];
    if (imgs.length < 2) continue;
    const show = (key?: string) => {
      const target = imgs.find((im) => im.dataset.for === key) ?? imgs[0];
      imgs.forEach((im) => im.classList.toggle('is-shown', im === target));
    };
    card.querySelectorAll<HTMLElement>('[data-preview]').forEach((link) => {
      const key = link.dataset.preview;
      link.addEventListener('mouseenter', () => show(key));
      link.addEventListener('focus', () => show(key));
    });
    card.addEventListener('mouseleave', () => show());
    card.addEventListener('focusout', (e) => {
      if (!card.contains(e.relatedTarget as Node)) show();
    });
  }

  // Stats: count up from 0 to the number ("55+", "50 States") every time the band scrolls into view.
  const counters = [...document.querySelectorAll<HTMLElement>('.stat-value[data-count]')];
  if (counters.length && !reduceMotion.matches && 'IntersectionObserver' in window) {
    const DURATION = 700; // ms
    const parts = (el: HTMLElement) => {
      const [, num, suffix] = el.dataset.count!.match(/^(\d+)(.*)$/)!;
      return { target: Number(num), suffix };
    };
    const timers = new Map<HTMLElement, number>();
    const frames = new Map<HTMLElement, number>();
    const stop = (el: HTMLElement) => {
      clearTimeout(timers.get(el));
      cancelAnimationFrame(frames.get(el) ?? 0);
    };
    const reset = (el: HTMLElement) => {
      stop(el);
      el.textContent = `0${parts(el).suffix}`;
    };
    const run = (el: HTMLElement) => {
      stop(el);
      const { target, suffix } = parts(el);
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / DURATION);
        const eased = 1 - Math.pow(1 - t, 3); // ease-out: fast start, gentle landing
        el.textContent = `${Math.round(target * eased)}${suffix}`;
        if (t < 1) frames.set(el, requestAnimationFrame(tick));
      };
      frames.set(el, requestAnimationFrame(tick));
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.intersectionRatio >= 0.6) {
            // On first load the stats card is still rising in (CSS delay ~0.75s); wait so the count is visible.
            const wait = Math.max(0, 1050 - performance.now());
            timers.set(el, window.setTimeout(() => run(el), wait));
          } else if (!entry.isIntersecting) {
            reset(el); // fully out of view: ready to count again next time
          }
        }
      },
      { threshold: [0, 0.6] },
    );
    for (const el of counters) {
      reset(el);
      io.observe(el);
    }
  }
</script>
