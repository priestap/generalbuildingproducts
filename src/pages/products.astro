---
import Base from '../layouts/Base.astro';
import products from '../data/products.json';
import { normalizeUrl } from '../lib/url';
import { slugify } from '../lib/slug';

const subtitle = 'General Building Products is committed to bringing you the highest quality products available.';
---

<Base title="Products" description={subtitle}>
  <div class="page products-page">
    <header class="page-header container">
      <h1>Products</h1>
      <p class="lead">{subtitle}</p>
    </header>

    <ul class="container product-grid">
      {
        products.map((c) => (
          <li class="product-card" id={slugify(c.category)}>
            <div class="product-card-head">
              {c.image && <img src={c.image} alt="" width="400" height="270" loading="lazy" />}
              <h2>{c.category}</h2>
            </div>
            <ul class="brand-list">
              {(c.brands ?? []).map((b) => (
                <li>
                  <a href={normalizeUrl(b.url)} target="_blank" rel="noopener">
                    {b.name}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
