---
import Base from '../layouts/Base.astro';
import products from '../data/products.json';
import site from '../data/site.json';
import home from '../data/home.json';
import { normalizeUrl, telUrl } from '../lib/url';
import { slugify } from '../lib/slug';
import { groupProducts } from '../lib/productGroups';

// Use the same figure as the home page stats band ("35+"), so the two never disagree.
const manufacturers = home.stats?.find((s) => /manufacturer/i.test(s.label))?.value ?? 'dozens of';

const subtitle = `Doors, frames, hardware, and the specialties that finish a job, from ${manufacturers} manufacturers. Find what you need below, or call and we’ll track it down.`;

const groups = groupProducts(products);

// "Chem Pruf (Fiberglass)" -> name "Chem Pruf", note "Fiberglass"
const splitBrand = (name: string) => {
  const m = name.match(/^(.*?)\s*\((.+)\)\s*$/);
  return m ? { name: m[1], note: m[2] } : { name, note: '' };
};
---

<Base title="Products" description={subtitle}>
  <div class="products-page">
    <header class="products-header">
      <div class="container">
        <p class="smallcaps">Our Products</p>
        <h1>What we supply</h1>
        <p class="lead">{subtitle}</p>

        <div class="products-tools">
          <nav class="group-jump" aria-label="Product groups">
            {groups.map((g) => (
              <a href={`#${slugify(g.name)}`}>
                {g.name}
                <span class="count">{g.items.length}</span>
              </a>
            ))}
          </nav>
          <div class="product-search" hidden>
            <label for="product-filter" class="sr-only">Find a product or brand</label>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="M20 20l-4-4"></path>
            </svg>
            <input id="product-filter" type="search" placeholder="Find a product or brand…" autocomplete="off" />
          </div>
        </div>
      </div>
    </header>

    <div class="container">
      {
        groups.map((g) => (
          <section class="product-group" id={slugify(g.name)} aria-labelledby={`${slugify(g.name)}-title`}>
            <div class="group-intro">
              <h2 id={`${slugify(g.name)}-title`}>{g.name}</h2>
              {g.blurb && <p>{g.blurb}</p>}
            </div>
            <ul class="product-grid">
              {g.items.map((c) => (
                <li class="product-card" id={slugify(c.category)}>
                  {c.image && <img src={c.image} alt="" width="96" height="96" loading="lazy" />}
                  <div class="product-body">
                    <h3>{c.category}</h3>
                    <ul class="brand-list" aria-label={`Brands for ${c.category}`}>
                      {(c.brands ?? []).map((b) => {
                        const { name, note } = splitBrand(b.name);
                        return (
                          <li>
                            <a href={normalizeUrl(b.url)} target="_blank" rel="noopener">
                              {name}
                              {note && <span class="brand-note">{note}</span>}
                              <svg class="ext" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                                <path d="M7 17L17 7M9 7h8v8"></path>
                              </svg>
                              <span class="sr-only"> (opens in a new tab)</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <p class="filter-empty" hidden role="status"></p>

      <aside class="products-cta">
        <div>
          <h2>Don’t see what you need?</h2>
          <p>
            We work with {manufacturers} manufacturers, and this isn’t the full list. Tell us the opening or the spec and
            we’ll find the right product.
          </p>
        </div>
        <div class="products-cta-actions">
          <a class="btn btn-gold" href={telUrl(site.phone)}>Call {site.phone}</a>
          <a class="btn btn-ghost" href="/#contact">Send a message</a>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  // Filter cards by category or brand name. Hidden without JS, so the full list always shows.
  const box = document.querySelector<HTMLElement>('.product-search');
  const input = document.querySelector<HTMLInputElement>('#product-filter');
  const empty = document.querySelector<HTMLElement>('.filter-empty');
  if (box && input && empty) {
    box.hidden = false;
    const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, ' ').trim();
    const cards = [...document.querySelectorAll<HTMLElement>('.product-card')].map((el) => ({
      el,
      text: norm(el.textContent ?? ''),
    }));
    const sections = [...document.querySelectorAll<HTMLElement>('.product-group')];

    const apply = () => {
      const q = norm(input.value);
      let shown = 0;
      for (const c of cards) {
        const match = !q || q.split(' ').every((w) => c.text.includes(w));
        c.el.hidden = !match;
        if (match) shown++;
      }
      for (const s of sections) s.hidden = !s.querySelector('.product-card:not([hidden])');
      empty.hidden = shown > 0;
      empty.textContent = shown
        ? ''
        : `Nothing listed for “${input.value.trim()}”, but we can probably still get it. Give us a call.`;
    };
    input.addEventListener('input', apply);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        input.value = '';
        apply();
      }
    });
  }
</script>
